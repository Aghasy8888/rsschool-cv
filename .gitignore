# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

# Static export — build locally, publish with `npx gh-pages -d out` (do not commit)
/out/

# production
/build

# gh-pages cache (if CACHE_DIR is customized outside node_modules)
.cache
/node_modules/.cache/gh-pages

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cursor local rules (not committed)
.cursor/
